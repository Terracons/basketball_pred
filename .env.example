# Optional. ESPN and SportsDataverse work without API keys.
CBBD_API_KEY=
ODDS_API_KEY=
# Set these to your ACTUAL remaining monthly allowance before first use if
# you have already used the key elsewhere. Local tracking cannot see other apps.
CBBD_MONTHLY_BUDGET=900
ODDS_MONTHLY_BUDGET=450
CBBD_DAILY_BUDGET=24
ODDS_DAILY_BUDGET=14
ESPN_DAILY_BUDGET=250
DATA_DIR=./data

# Optional intelligence. Keys remain on the local server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
TAVILY_API_KEY=
OPENROUTER_MAX_REQUEST_USD=0.03
OPENROUTER_DAILY_BUDGET_USD=0.20
OPENROUTER_MONTHLY_BUDGET_USD=3
OPENROUTER_DAILY_REQUESTS=20
OPENROUTER_MONTHLY_REQUESTS=300
TAVILY_DAILY_REQUESTS=10
TAVILY_MONTHLY_REQUESTS=200
PORT=3100
# Required for Vercel. Choose at least 16 characters. Optional for local use.
APP_PASSWORD=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only needed for a custom domain, e.g. https://your-domain.example
APP_ORIGIN=
